// Define the column indices for the InvoiceLog (0-indexed)
const LOG_COLUMN_MAP = {
  SUBMISSION_DATE: 0,   // A: Submission Date
  SME_EMAIL: 1,         // B: SME Email
  MONTH_YEAR: 2,        // C: Month and Year
  SME_NAME: 3,          // D: SME Name
  ROLE_PROJECT: 4,      // E: Role/ Project
  EFFORT_URL: 5,        // F: Effort tracker URL
  INVOICE_AMOUNT: 6,    // G: Invoice amount
  PERIOD: 7,            // H: period
