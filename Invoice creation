/* ---------- HELPERS ---------- */
function findCol(headers, keywords) {
  if (!headers || headers.length === 0) return -1;
  const hLower = headers.map(h => String(h || "").toLowerCase());
  for (let i = 0; i < hLower.length; i++) {
    for (let k of keywords) {
      if (hLower[i].indexOf(k) !== -1) return i;
    }
  }
  return -1;
}
function round2(n) {
  return Math.round((Number(n) + Number.EPSILON) * 100) / 100;
}

/*
  friendlyCourseName:
  - central place to convert a sheet name (or loose course text) into a canonical Role/Project text
  - mapping intentionally includes many "master ..." variants so the value written to Master data is accurate
*/
function friendlyCourseName(sheetName) {
  if (!sheetName) return "";
  const s = sheetName.toString().toLowerCase();

  // explicit mappings (covers the "master ..." sheet name variants you mentioned)
  const map = [
    { k: "master 25-26", v: "Data Analytics" },
    { k: "master 25 26", v: "Data Analytics" },
    { k: "master comm", v: "Community Live Classes" },
    { k: "master community", v: "Community Live Classes" },
    { k: "master ds", v: "Data Science" },
    { k: "master data science", v: "Data Science" },
    { k: "master da", v: "Data Analytics" },
    { k: "da", v: "Data Analytics" },
    { k: "data analytics", v: "Data Analytics" },
    { k: "ds", v: "Data Science" },
    { k: "gen ai", v: "Generative AI" },
    { k: "genai", v: "Generative AI" },
    { k: "master gen ai", v: "Generative AI" },
    { k: "Generative AI", v: "GEN AI" },
    { k: "master genai", v: "Generative AI" },
    { k: "master fsd", v: "Full Stack Development" },
    { k: "fsd", v: "Full Stack Development" },
    { k: "full stack", v: "Full Stack Development" },
    { k: "master full stack", v: "Full Stack Development" },
    // you can add more explicit patterns here as needed
  ];

  for (let i = 0; i < map.length; i++) {
    if (s.indexOf(map[i].k) !== -1) return map[i].v;
  }

  // fallback: clean up and title-case a generic name
  let cleaned = sheetName.replace(/master/i, "").replace(/[_\-]+/g, " ").trim();
  cleaned = cleaned.split(/\s+/).map(w => {
    w = w.trim();
    return w ? w[0].toUpperCase() + w.slice(1).toLowerCase() : "";
  }).join(" ");
  return cleaned || sheetName;
}

function parseMonthString(str) {
  if (!str) return null;
  const s = String(str).trim();
  const monthNames = [
    "January","February","March","April","May","June","July","August","September","October","November","December"
  ];
  const m1 = s.match(/^([A-Za-z]+)\s+(\d{4})$/);
  if (m1) {
    const mIndex = monthNames.findIndex(m => m.toLowerCase().startsWith(m1[1].toLowerCase().substring(0, 3)));
    if (mIndex === -1) return null;
    const year = parseInt(m1[2], 10);
    const lastDate = new Date(year, mIndex + 1, 0);
    return { year, monthName: monthNames[mIndex], lastDay: lastDate.getDate(), lastDate };
  }
  const m2 = s.match(/^(\d{1,2})[\/\-](\d{4})$/);
  if (m2) {
    const mIndex = parseInt(m2[1], 10) - 1;
    if (mIndex < 0 || mIndex > 11) return null;
    const year = parseInt(m2[2], 10);
    const lastDate = new Date(year, mIndex + 1, 0);
    return { year, monthName: monthNames[mIndex], lastDay: lastDate.getDate(), lastDate };
  }
  return null;
}

/* ======= SME map builder (cached) ======= */
function buildSmeLinksMap(forceReload) {
  const now = Date.now();
  if (!forceReload && _SME_CACHE.data && (now - _SME_CACHE.ts) < CONFIG._smeCacheTtl) {
    return _SME_CACHE.data;
  }

  const smeSS = SpreadsheetApp.openByUrl(CONFIG.smeManagementUrl);
  const sheets = smeSS.getSheets();

  const normalize = s => (s || "").toString().normalize('NFKC').trim().replace(/\s+/g, ' ').toLowerCase();
  const linksMap = {};
  let rowsScanned = 0;

  // Build allowed courses map based on SME spreadsheet sheet names
  const allowed = {};
  sheets.forEach(sh => {
    const key = sh.getName().toLowerCase();
    const friendly = friendlyCourseName(sh.getName());
    if (friendly && key !== 'onboarded') allowed[key] = friendly;
  });

  Object.keys(allowed).forEach(sheetKey => {
    const sh = sheets.find(s => s.getName().toLowerCase() === sheetKey);
    if (!sh) return;
    const course = allowed[sheetKey];
    const lastRow = sh.getLastRow();
    if (lastRow < 2) return;

    const numRows = lastRow - 1;
    const names = sh.getRange(2, 1, numRows, 1).getValues();
    const emails = sh.getRange(2, 2, numRows, 1).getValues();
    const richH = sh.getRange(2, 8, numRows, 1).getRichTextValues();
    const textsH = sh.getRange(2, 8, numRows, 1).getValues();

    for (let i = 0; i < names.length; i++) {
      const rawName = names[i][0];
      if (!rawName || String(rawName).toString().trim() === '') continue;
      rowsScanned++;
      const nameNorm = normalize(rawName);
      if (!linksMap[nameNorm]) linksMap[nameNorm] = { __any: [], __email: '', __courses: [] };

      const candidateEmail = (emails[i] && emails[i][0]) ? String(emails[i][0]).trim() : "";
      if (candidateEmail && !linksMap[nameNorm].__email) linksMap[nameNorm].__email = candidateEmail;

      let url = "";
      const rich = (richH[i] && richH[i][0]);
      if (rich && typeof rich.getLinkUrl === 'function') url = rich.getLinkUrl() || "";
      if (!url) {
        const textCandidate = (textsH[i] && textsH[i][0]) || "";
        if (typeof textCandidate === 'string' && textCandidate.trim().match(/^https?:\/\//i)) {
          url = textCandidate.trim();
        } else {
          // no link found in this cell
          url = "";
        }
      }

      // store course-specific url and course membership
      if (url) {
        linksMap[nameNorm][course] = url;
        linksMap[nameNorm].__any.push(url);
      }
      if (!linksMap[nameNorm].__courses.includes(course)) {
        linksMap[nameNorm].__courses.push(course);
      }
    }
  });

  const result = { linksMap, rowsScanned };
  _SME_CACHE = { ts: now, data: result };
  return result;
}

/* ======= fetchMonthsForUi - used by MonthPicker.html ======= */
function fetchMonthsForUi() {
  const eff = SpreadsheetApp.openByUrl(CONFIG.effortTrackerUrl);
  const sheets = eff.getSheets().filter(s => /master/i.test(s.getName()));
  const set = new Set();
  const monthNames = ["jan","feb","mar","apr","may","jun","jul","aug","sep","oct","nov","dec"];

  sheets.forEach(sh => {
    const lastRow = sh.getLastRow();
    if (lastRow < 2) return;
    const data = sh.getRange(1, 1, Math.min(lastRow, 500), Math.max(1, sh.getLastColumn())).getValues();
    const headers = data[0].map(h => String(h || "").toLowerCase());
    const colMonth = findCol(headers, ["month"]);
    if (colMonth === -1) return;
    for (let r = 1; r < data.length; r++) {
      const v = data[r][colMonth];
      if (!v) continue;
      const s = String(v).trim();
      if (s === "") continue;
      const lower = s.toLowerCase();
      if (monthNames.some(m => lower.indexOf(m) !== -1) || /\d{1,2}[\/\-]\d{4}/.test(lower) || /^[a-z]{3,}\s+\d{4}$/i.test(s)) {
        set.add(s);
      }
    }
  });

  return Array.from(set).sort();
}

/* ======= fetchPeriodsForSendUi - used by SendMonthPicker.html ======= */
function fetchPeriodsForSendUi() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const master = ss.getSheetByName(CONFIG.masterDataSheetName);
  if (!master) return [];
  const data = master.getDataRange().getValues();
  if (data.length < 2) return [];
  const headers = data[0].map(String);
  const cPeriod = findCol(headers, ["month and year", "period", "month"]);
  if (cPeriod === -1) return [];
  const set = new Set();
  for (let i = 1; i < data.length; i++) {
    const v = data[i][cPeriod];
    if (v && String(v).trim() !== "") set.add(String(v).trim());
  }
  return Array.from(set).sort();
}

/* ======= runCreateInvoice (main) ======= */
function runCreateInvoice(selectedMonth) {
  if (!selectedMonth) throw new Error('No month selected.');

  const effortSS = SpreadsheetApp.openByUrl(CONFIG.effortTrackerUrl);
  const masterSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.masterDataSheetName);
  if (!masterSheet) throw new Error(`Sheet "${CONFIG.masterDataSheetName}" not found.`);

  const tz = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
  const totals = {}; // key = instructor|course

  // iterate Master* sheets (bulk read each sheet)
  const sheets = effortSS.getSheets().filter(s => /master/i.test(s.getName()));

  sheets.forEach(sheet => {
    // canonical friendly course name derived from sheet name
    const course = friendlyCourseName(sheet.getName());
    const lastRow = sheet.getLastRow();
    const lastCol = Math.max(1, sheet.getLastColumn());
    if (lastRow < 2) return;
    const data = sheet.getRange(1, 1, lastRow, lastCol).getValues();
    const headers = data[0].map(h => String(h || '').toLowerCase());
    const colSME = findCol(headers, ['sme', 'instructor', 'name']);
    const colMonth = findCol(headers, ['month']);
    const colFinal = findCol(headers, ['final round', 'final amount', 'amount']);
    if (colSME === -1 || colFinal === -1) return;

    for (let i = 1; i < data.length; i++) {
      const monthCell = colMonth !== -1 ? data[i][colMonth] : '';
      if (monthCell && String(monthCell).trim() !== String(selectedMonth).trim()) continue;
      const sme = String(data[i][colSME] || '').trim();
      if (!sme) continue;
      const amt = parseFloat(String(data[i][colFinal]).replace(/[^0-9\.\-]/g, '')) || 0;
      // use the canonical course string in the key so master row will have correct Role/Project text
      const key = `${sme}|${course}`;
      totals[key] = (totals[key] || 0) + amt;
    }
  });

  // build linksMap once (used later by populate function)
  buildSmeLinksMap(); // warm cache

  // Optionally replace existing month rows in master sheet while preserving header formatting
  if (CONFIG.replaceExistingMonth) {
    const vals = masterSheet.getDataRange().getValues();
    if (vals.length > 0) {
      const header = vals[0];
      const keep = [header]; // header row preserved
      for (let i = 1; i < vals.length; i++) {
        if (String(vals[i][0]).trim() !== String(selectedMonth).trim()) keep.push(vals[i]);
      }
      masterSheet.clearContents();
      if (keep.length > 0) masterSheet.getRange(1, 1, keep.length, keep[0].length).setValues(keep);
    }
  }

  const parsed = parseMonthString(selectedMonth);
  const period = parsed ? `1 ${parsed.monthName} - ${parsed.lastDay} ${parsed.monthName} ${parsed.year}` : selectedMonth;
  const invoiceLastDate = Utilities.formatDate(new Date(), tz, 'dd MM yyyy');
  const invoiceDated = parsed ? Utilities.formatDate(parsed.lastDate, tz, 'dd/MM/yyyy') : invoiceLastDate;

  const rows = [];
  Object.entries(totals).forEach(([key, amount]) => {
    const [sme, course] = key.split('|');
    // write canonical friendly course into master data (Role/Project column)
    rows.push([
      selectedMonth,
      sme,
      course,             // <-- canonical Role / Project text
      "",                 // D: will be populated by populateTrackerUrlsImproved2_withEmail()
      round2(amount),
      period,
      invoiceLastDate,
      "",                // invoice number
      invoiceDated,
    ]);
  });

  if (rows.length === 0) return { status: 'empty', message: 'No data found for that month.' };

  const start = masterSheet.getLastRow() + 1;
  masterSheet.getRange(start, 1, rows.length, rows[0].length).setValues(rows);

  // Auto-populate tracker links & emails right after creating rows (best-effort; non-fatal)
  try {
    populateTrackerUrlsImproved2_withEmail();
  } catch (e) {
    Logger.log("populateTrackerUrlsImproved2_withEmail failed: " + e.message);
  }

  return { status: 'ok', written: rows.length };
}

/* ======= populateTrackerUrlsImproved2_withEmail (optimized, course-specific matching) =======
   - Uses SME cache to avoid multiple SS opens
   - Only matches SME name within the same course (no cross-course fallback)
   - Writes Tracker column as RichText "Tracker Link" with hyperlink
*/
function populateTrackerUrlsImproved2_withEmail() {
  const masterSs = SpreadsheetApp.getActiveSpreadsheet();
  const masterSheet = masterSs.getSheetByName(CONFIG.masterDataSheetName);
  if (!masterSheet) throw new Error("Master data sheet not found: " + CONFIG.masterDataSheetName);

  const smeInfo = buildSmeLinksMap();
  const linksMap = smeInfo.linksMap || {};
  const normalize = s => (s || "").toString().normalize('NFKC').trim().replace(/\s+/g, ' ').toLowerCase();

  const startRow = 2;
  const lastRow = masterSheet.getLastRow();
  if (lastRow < startRow) return { updated: 0, notFound: 0, emailsWritten: 0, unmatchedSample: [] };

  const numRows = lastRow - startRow + 1;

  // Bulk-read values and existing rich text for tracker column
  const rowsValues = masterSheet.getRange(startRow, 1, numRows, 10).getValues(); // A:J
  const existingRichTracker = masterSheet.getRange(startRow, 4, numRows, 1).getRichTextValues(); // col D

  // Arrays to hold out data for specific columns
  const trackerRichOut = Array.from({length: numRows}, () => [null]); // will contain RichTextValue or existing
  const emailsOut = Array.from({length: numRows}, () => [""]);
  let updated = 0, notFound = 0, emailsWritten = 0;

  for (let r = 0; r < rowsValues.length; r++) {
    const row = rowsValues[r];
    const instrRaw = row[1] || ''; // col B
    const courseRaw = row[2] || ''; // col C
    const existingD = (existingRichTracker[r] && existingRichTracker[r][0]) ? existingRichTracker[r][0] : null;
    const existingJ = row[9] || '';  // col J
    const instrNorm = normalize(instrRaw);
    const course = String(courseRaw).trim();

    let foundUrl = "";
    let foundEmail = "";

    // Strict course-specific lookup:
    // - Use normalized instructor name as key (linksMap built from SME sheets)
    // - Expect the record to contain a property keyed by the friendly course name (same as stored in master)
    if (instrNorm && linksMap[instrNorm]) {
      const record = linksMap[instrNorm];
      // Only accept a URL if present for the exact course stored in Master (no fallback)
      if (record[course]) {
        foundUrl = record[course];
      }
      if (record.__email) {
        foundEmail = record.__email;
      }
    }

    // Prepare tracker rich text: only change if we found a new URL; otherwise keep existingRich
    if (foundUrl) {
      const builder = SpreadsheetApp.newRichTextValue().setText("Tracker Link");
      try {
        builder.setLinkUrl(foundUrl);
        trackerRichOut[r][0] = builder.build();
      } catch (e) {
        trackerRichOut[r][0] = SpreadsheetApp.newRichTextValue().setText(foundUrl).build();
      }
      updated++;
    } else {
      if (existingD && typeof existingD.getText === 'function' && String(existingD.getText()).trim() !== "") {
        trackerRichOut[r][0] = existingD;
      } else {
        trackerRichOut[r][0] = SpreadsheetApp.newRichTextValue().setText("").build();
        notFound++;
      }
    }

    // Email column: write only when we found an email and it's different
    if (foundEmail && String(foundEmail).trim() !== String(existingJ).trim()) {
      emailsOut[r][0] = foundEmail;
      emailsWritten++;
    } else {
      emailsOut[r][0] = existingJ || "";
    }
  }

  // Write tracker rich column (col D) in one batch
  try {
    masterSheet.getRange(startRow, 4, numRows, 1).setRichTextValues(trackerRichOut);
  } catch (e) {
    const plainTrackerOut = trackerRichOut.map(cell => [cell && cell.getText ? cell.getText() : ""]);
    masterSheet.getRange(startRow, 4, numRows, 1).setValues(plainTrackerOut);
    Logger.log("setRichTextValues failed, fallback to setValues for tracker: " + e.message);
  }

  // Write emails column (col J)
  masterSheet.getRange(startRow, 10, numRows, 1).setValues(emailsOut);

  // Build unmatched sample for debugging
  const unmatchedSample = [];
  for (let r = 0; r < rowsValues.length && unmatchedSample.length < 30; r++) {
    const instr = rowsValues[r][1] || '';
    const course = rowsValues[r][2] || '';
    const d = trackerRichOut[r][0] && trackerRichOut[r][0].getText ? trackerRichOut[r][0].getText() : '';
    if (!d || String(d).trim() === '') unmatchedSample.push({ row: startRow + r, instructor: instr, course });
  }

  Logger.log('populateTrackerUrlsImproved2_withEmail: updated=%s notFound=%s emailsWritten=%s totalRows=%s',
             updated, notFound, emailsWritten, rowsValues.length);

  return { updated, notFound, emailsWritten, unmatchedSample };
}

function debugGenerativeAILookup() {
