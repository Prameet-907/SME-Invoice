  const linksMap = smeInfo.linksMap || {};
  
  console.log("=== DEBUG Generative AI Lookup ===");
  
  // Check what courses are available in SME data
  const allCourses = new Set();
  Object.keys(linksMap).forEach(name => {
    const record = linksMap[name];
    record.__courses.forEach(course => allCourses.add(course));
  });
  
  console.log("Available courses in SME data:", Array.from(allCourses));
  
  // Check specific instructors for Generative AI
  const genAIInstructors = Object.keys(linksMap).filter(name => {
